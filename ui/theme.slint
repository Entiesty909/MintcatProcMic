//! 视觉 token。软件渲染器，质感靠层次、间距、字重、配色，不用模糊/发光/动画。

export global Theme {
    // 底色与容器
    out property <color> bg: #F0F0F0;
    out property <color> card: #FFFFFF;
    out property <color> field: #FFFFFF;
    out property <color> border: #D0D0D0;
    out property <color> accent: #0078D4;
    out property <color> accentSoft: #E5F1FB;
    out property <color> ok: #107C10;
    out property <color> warn: #C19C00;
    out property <color> danger: #C42B1C;
    out property <color> onAccent: #FFFFFF;
    out property <color> text: #1F1F1F;
    out property <color> text2: #606060;
    out property <color> text3: #888888;
    out property <length> radiusCard: 4px;
    out property <length> radiusControl: 2px;
    out property <length> padPage: 20px;
    out property <length> padCard: 16px;
    out property <length> gap: 10px;
    out property <length> gapLg: 14px;

    // 尺寸
    out property <length> controlHeight: 34px;
    out property <length> topBarHeight: 56px;
    out property <length> statusBarHeight: 56px;
    out property <length> meterHeight: 36px;
}
