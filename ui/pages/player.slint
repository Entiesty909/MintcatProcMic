//! 音频库页面。右键菜单本体在 main.slint 的窗口顶层，这里只负责记录坐标与开关。

import { LineEdit, CheckBox, Slider } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Card } from "../components/card.slint";
import { PmButton } from "../components/button.slint";

export component PlayerPage inherits Rectangle {
    in-out property <string> output-name: "";
    in-out property <[string]> categories: ["全部", "未分类"];
    in-out property <int> category-index: 0;
    in-out property <string> category-edit-name: "";
    in-out property <[string]> entries: [];
    in-out property <[string]> entry-durations: [];
    in-out property <int> entry-index: -1;
    in-out property <float> progress: 0;
    in-out property <bool> seeking-progress: false;
    in-out property <string> search: "";
    in-out property <string> current-name: "";
    in-out property <string> current-position: "";
    in-out property <float> duration-seconds: 0;
    in-out property <bool> loop: false;
    in-out property <bool> playing: false;
    in-out property <string> entry-edit-name: "";
    in-out property <bool> category-menu-open: false;
    in-out property <bool> entry-menu-open: false;
    in-out property <length> category-menu-x: 0px;
    in-out property <length> category-menu-y: 0px;
    in-out property <length> entry-menu-x: 0px;
    in-out property <length> entry-menu-y: 0px;

    callback category-changed(int);
    callback category-context(int);
    callback entry-context(int);
    callback entry-edit-tags();
    callback entry-save-tags();
    callback search-changed(string);
    callback entry-double-clicked(int);
    callback progress-seek(float);
    callback add-files();
    callback stop();
    callback open-settings();

    background: transparent;

    VerticalLayout {
        padding: Theme.padPage;
        spacing: Theme.gap;

        // 工具条
        HorizontalLayout {
            height: Theme.controlHeight;
            spacing: 8px;
            PmButton {
                label: "+ 添加文件";
                clicked => { root.add-files(); }
            }
            LineEdit {
                horizontal-stretch: 1;
                placeholder-text: "搜索音频…";
                text <=> root.search;
                edited(t) => { root.search-changed(t); }
            }
            Text {
                text: root.output-name == "" ? "目标：未选择" : "目标：" + root.output-name;
                color: Theme.text2;
                font-size: 12px;
                vertical-alignment: TextVerticalAlignment.center;
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: Theme.gap;

            // 分类树
            Card {
                width: 250px;
                VerticalLayout {
                    Text {
                        text: "音频分类";
                        color: Theme.text2;
                        font-size: 12px;
                        font-weight: 600;
                    }
                    Text {
                        text: "右键打开 Windows 11 风格菜单";
                        color: Theme.text3;
                        font-size: 12px;
                    }
                    VerticalLayout {
                        vertical-stretch: 1;
                        for category[index] in root.categories: Rectangle {
                            height: 32px;
                            background: index == root.category-index
                                ? Theme.accentSoft
                                : transparent;
                            border-radius: Theme.radiusControl;
                            Text {
                                text: category;
                                x: 12px;
                                color: index == root.category-index ? Theme.accent : Theme.text;
                                vertical-alignment: TextVerticalAlignment.center;
                            }
                            TouchArea {
                                clicked => {
                                    root.category-index = index;
                                    root.category-changed(index);
                                    root.category-menu-open = false;
                                    root.entry-menu-open = false;
                                }
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.right
                                        && event.kind == PointerEventKind.down) {
                                        root.category-index = index;
                                        root.category-context(index);
                                        root.category-menu-x =
                                            self.absolute-position.x + self.mouse-x;
                                        root.category-menu-y =
                                            self.absolute-position.y + self.mouse-y;
                                        root.category-menu-open = true;
                                        root.entry-menu-open = false;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 音频列表
            Card {
                horizontal-stretch: 1;
                min-width: 0px;
                VerticalLayout {
                    HorizontalLayout {
                        height: Theme.controlHeight;
                        Text { text: "索引"; width: 52px; color: Theme.text2; }
                        Text { text: "音频名称"; horizontal-stretch: 1; color: Theme.text2; }
                        Text { text: "时长"; width: 76px; color: Theme.text2; }
                        Text { text: "状态"; width: 64px; color: Theme.text2; }
                    }
                    VerticalLayout {
                        vertical-stretch: 1;
                        for name[index] in root.entries: Rectangle {
                            height: 32px;
                            background: index == root.entry-index ? Theme.accentSoft : transparent;
                            Text {
                                text: "\{index + 1}";
                                x: 8px;
                                width: 44px;
                                color: Theme.text2;
                            }
                            Text {
                                text: name;
                                x: 56px;
                                width: parent.width - 210px;
                                color: Theme.text;
                                overflow: elide;
                            }
                            Text {
                                text: index < root.entry-durations.length
                                    ? root.entry-durations[index]
                                    : "—";
                                x: parent.width - 142px;
                                width: 76px;
                                color: Theme.text2;
                                horizontal-alignment: right;
                            }
                            Text {
                                text: index == root.entry-index && root.playing ? "播放中" : "";
                                x: parent.width - 66px;
                                width: 58px;
                                color: Theme.accent;
                            }
                            TouchArea {
                                clicked => {
                                    root.entry-index = index;
                                    root.entry-double-clicked(index);
                                    root.entry-menu-open = false;
                                }
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.right
                                        && event.kind == PointerEventKind.down) {
                                        root.entry-index = index;
                                        root.entry-context(index);
                                        root.entry-menu-x = self.absolute-position.x + self.mouse-x;
                                        root.entry-menu-y = self.absolute-position.y + self.mouse-y;
                                        root.entry-menu-open = true;
                                        root.category-menu-open = false;
                                    }
                                }
                            }
                        }
                    }
                    Text {
                        text: "双击播放；右键音频可选择播放目标和文件操作。";
                        color: Theme.text3;
                        font-size: 12px;
                    }
                }
            }
        }

        // 播放条：状态 + 进度 + 进度文字 + 循环 + 停止
        Card {
            height: 70px;
            VerticalLayout {
                HorizontalLayout {
                    height: Theme.controlHeight;
                    spacing: 8px;
                    Text {
                        text: root.playing ? "▶" : "■";
                        width: 20px;
                        color: root.playing ? Theme.accent : Theme.text3;
                    }
                    Text {
                        text: root.current-name == "" ? "未播放" : root.current-name;
                        width: 220px;
                        color: Theme.text;
                        overflow: elide;
                    }
                    Slider {
                        horizontal-stretch: 1;
                        minimum: 0;
                        maximum: 1;
                        value <=> root.progress;
                        // 拖动时只跟手，松手才真正跳转，避免边拖边重启解码。
                        changed(v) => { root.seeking-progress = true; }
                        released(v) => {
                            root.seeking-progress = false;
                            root.progress-seek(v);
                        }
                    }
                    Text {
                        text: root.current-position;
                        width: 90px;
                        color: Theme.text2;
                    }
                    CheckBox {
                        text: "循环";
                        checked <=> root.loop;
                    }
                    PmButton {
                        label: "停止";
                        enabled: root.playing;
                        clicked => { root.stop(); }
                    }
                }
            }
        }
    }
}
