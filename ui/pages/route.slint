//! 路由页：进程声源 + 物理麦混入 + 输出状态。输出设备与麦克风的选择在设置页，
//! 这里只显示当前目标，避免同一个属性被两处控件双向绑定。

import { ComboBox, LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Card } from "../components/card.slint";
import { PmButton } from "../components/button.slint";
import { LevelMeter } from "../components/level-meter.slint";
import { SliderRow } from "../components/slider-row.slint";

//! 只读字段：显示当前值，改动入口在别处。
component ReadOnlyField inherits Rectangle {
    in property <string> text: "";
    in property <string> placeholder: "";

    height: Theme.controlHeight;
    min-width: 0px;
    background: Theme.field;
    border-radius: Theme.radiusControl;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: LayoutAlignment.center;
        Text {
            horizontal-stretch: 1;
            text: root.text == "" ? root.placeholder : root.text;
            color: root.text == "" ? Theme.text3 : Theme.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: TextVerticalAlignment.center;
            overflow: elide;
        }
    }
}

export component RoutePage inherits Rectangle {
    in-out property <[string]> processes: [];
    in-out property <int> process-index: 0;
    in-out property <string> selected-processes: "";
    in-out property <string> process-filter: "";
    in-out property <float> volume: 100;
    in-out property <float> mic-volume: 100;
    in-out property <[float]> capture-wave: [];
    in-out property <[float]> mic-wave: [];
    in-out property <[float]> render-wave: [];
    in-out property <string> output-name: "";
    in-out property <string> mic-name: "";
    in-out property <string> dest-hint: "";
    in-out property <bool> running: false;
    in-out property <bool> has-mic: false;

    callback refresh();
    callback filter-changed(string);
    callback process-add();
    callback process-clear();
    callback volume-edited(float);
    callback mic-volume-edited(float);
    callback open-settings();
    background: transparent;

    HorizontalLayout {
        padding: Theme.padPage;
        spacing: Theme.gapLg;

        Card {
            horizontal-stretch: 1;
            min-width: 0px;
            HorizontalLayout {
                vertical-stretch: 0;
                Text {
                    text: "声音来源";
                    color: Theme.text2;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text {
                    text: root.running ? "捕获中" : "未捕获";
                    color: root.running ? Theme.ok : Theme.text3;
                    font-size: 12px;
                    vertical-alignment: TextVerticalAlignment.center;
                }
            }
            LineEdit {
                min-width: 0px;
                placeholder-text: "筛选进程…";
                text <=> root.process-filter;
                enabled: !root.running;
                edited(t) => { root.filter-changed(t); }
            }
            HorizontalLayout {
                vertical-stretch: 0;
                ComboBox {
                    min-width: 0px;
                    horizontal-stretch: 1;
                    model: root.processes;
                    current-index <=> root.process-index;
                    enabled: !root.running;
                }
                PmButton {
                    label: "刷新";
                    enabled: !root.running;
                    clicked => { root.refresh(); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                LineEdit {
                    horizontal-stretch: 1;
                    text <=> root.selected-processes;
                    enabled: false;
                    placeholder-text: "多个进程输入…";
                }
                PmButton {
                    label: "加入";
                    enabled: !root.running;
                    clicked => { root.process-add(); }
                }
                PmButton {
                    label: "清空";
                    enabled: !root.running;
                    clicked => { root.process-clear(); }
                }
            }
            LevelMeter { samples: root.capture-wave; tint: Theme.ok; }
            SliderRow {
                label: "音量";
                value <=> root.volume;
                edited(v) => { root.volume-edited(v); }
            }
        }

        Card {
            horizontal-stretch: 1;
            min-width: 0px;
            HorizontalLayout {
                vertical-stretch: 0;
                Text {
                    text: "送到哪里";
                    color: Theme.text2;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text {
                    text: root.running ? "输出中" : "未渲染";
                    color: root.running ? Theme.accent : Theme.text3;
                    font-size: 12px;
                    vertical-alignment: TextVerticalAlignment.center;
                }
            }
            ReadOnlyField {
                text: root.output-name;
                placeholder: "未选择输出设备";
            }
            HorizontalLayout {
                alignment: end;
                PmButton {
                    label: "更改输出设备";
                    enabled: !root.running;
                    clicked => { root.open-settings(); }
                }
            }
            LevelMeter { samples: root.render-wave; tint: #5856D6; }
            Text {
                text: root.dest-hint;
                color: Theme.text2;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}
