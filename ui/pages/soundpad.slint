//! 声板页：骨架阶段只有空态。pad 网格、热键触发、播放模式在后续阶段实装。

import { Theme } from "../theme.slint";
import { Card } from "../components/card.slint";
import { EmptyState } from "../components/empty-state.slint";

export component SoundpadPage inherits Rectangle {
    in-out property <string> output-name: "";

    callback open-settings();

    background: transparent;

    VerticalLayout {
        padding: Theme.padPage;
        spacing: Theme.gapLg;

        Card {
            vertical-stretch: 1;
            EmptyState {
                title: "声板还没实装";
                hint: "规划中的行为：把音频文件拖进来变成一格 pad，每格绑一个热键，支持单次 / 循环 / 按住 / 切换四种触发方式。";
                action-label: "去看输出设置";
                acted => { root.open-settings(); }
            }
        }
    }
}
